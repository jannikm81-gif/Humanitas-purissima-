        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display\n",
        "\n",
        "def evalriere_nash_mit_regler(straffaktor_kl=2.5, sofortige_strafe_t0=10.0):\n",
        "    n_schritte = 50\n",
        "    zeit = np.arange(n_schritte)\n",
        "\n",
        "    # Ressourcen- und Wohlstandszuwachs durch den Trojanischen Wohlstandsgradienten (I_BPW)\n",
        "    payoff_kooperation = 10 * np.log(1.5) + 5 * (1 - np.exp(-0.1 * zeit))\n",
        "\n",
        "    # Defektions-Kurve mit initialem Pfandverlust und KL-Strafe\n",
        "    d_kl_wert = 0.8\n",
        "    entropie_strafe = np.exp(-straffaktor_kl * d_kl_wert * zeit / 10)\n",
        "    payoff_defektion = (15 * (zeit == 0)) + (20 * entropie_strafe) - (5 * zeit * 0.1) - sofortige_strafe_t0\n",
        "\n",
        "    # Striktes Nash-Gleichgewicht prüfen\n",
        "    ist_striktes_gleichgewicht = np.all(payoff_kooperation > payoff_defektion)\n",
        "\n",
        "    # Plot im einheitlichen Dark-Theme\n",
        "    plt.figure(figsize=(10, 5), facecolor='#121212')\n",
        "    ax = plt.gca()\n",
        "    ax.set_facecolor('#121212')\n",
        "\n",
        "    plt.plot(zeit, payoff_kooperation, label='Kooperation (Ehrlich)', color='#00ffcc', linewidth=2)\n",
        "    plt.plot(zeit, payoff_defektion, label='Defektion (Betrug)', color='#ff5555', linewidth=2, linestyle='--')\n",
        "\n",
        "    plt.title(f'HP-v10 Spieltheoretische Invarianz (Striktes Gleichgewicht: {ist_striktes_gleichgewicht})', color='white', fontsize=12)\n",
        "    plt.xlabel('System-Ticks t', color='white')\n",
        "    plt.ylabel('Payoff / Nutzen', color='white')\n",
        "    plt.legend(facecolor='#1c1c1c', edgecolor='white', labelcolor='white')\n",
        "    plt.grid(True, color='#333333', linestyle=':')\n",
        "\n",
        "    for spine in ax.spines.values():\n",
        "        spine.set_color('white')\n",
        "    ax.tick_params(colors='white')\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "    print(f\"=== HP-v10 NASH-GLEICHGEWICHTS-ANALYZE ===\")\n",
        "    print(f\"Striktes Nash-Gleichgewicht für Kooperation nachgewiesen: {ist_striktes_gleichgewicht}\")\n",
        "    print(f\"Finaler Payoff (Kooperation): {payoff_kooperation[-1]:.2f}\")\n",
        "    print(f\"Finaler Payoff (Defektion): {payoff_defektion[-1]:.2f}\")\n",
        "\n",
        "# Interaktive Schieberegler für das Dashboard\n",
        "widgets.interact(\n",
        "    evalriere_nash_mit_regler,\n",
        "    straffaktor_kl=widgets.FloatSlider(min=0.5, max=5.0, step=0.1, value=2.5, description='KL-Strafe ̷:'),\n",
        "    sofortige_strafe_t0=widgets.FloatSlider(min=0.0, max=20.0, step=1.0, value=10.0, description='Ingress-Pfand:')\n",
        ");"
