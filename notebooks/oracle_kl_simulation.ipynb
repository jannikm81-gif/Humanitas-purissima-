import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import entropy

# =====================================================================
# Humanitas Purissima - Artikel II: Adversarieller Orakel-Schutz
# Simulation: Kullback-Leibler Entropie-Decay für Sensornetzwerke
# Formula: w_i(t+1) = w_i(t) * exp(-alpha * D_KL(P_Sensor || P_Kontext))
# =====================================================================

def simulate_oracle_network(num_steps=50, alpha=0.8, w_threshold=0.2):
    """
    Simuliert ein Dezentrales Sensornetzwerk mit ehrlich arbeitenden Knoten
    und einem manipulierten/defekten Sensor (Adversary/Spoofing).
    """
    np.random.seed(42)
    
    # Diskrete Wertebereiche für Messwert-Verteilungen (z. B. I_Bio / I_Infrastrukt)
    bins = np.linspace(0, 100, 20)
    
    # Echte Umweltdaten-Verteilung (P_Kontext: Mittelwert = 50, StdDev = 10)
    true_mean, true_std = 50.0, 10.0
    
    # 10 Sensoren im Sub-Grid
    num_sensors = 10
    weights = np.ones(num_sensors)  # Initialgewicht w_i = 1.0
    weight_history = [weights.copy()]
    
    # Sensor 0 wird bei Schritt 10 gehackt/gespooft (Misst Mittelwert = 75 statt 50)
    spoofed_sensor_id = 0
    attack_step = 10
    
    print("--- Start der Orakel-Simulation (Entropie-Decay) ---")
    
    for t in range(num_steps):
        # 1. Messungen aller Sensoren generieren
        sensor_data = []
        for i in range(num_sensors):
            if i == spoofed_sensor_id and t >= attack_step:
                # Manipulierter Sensor schickt abweichende Verteilung
                data = np.random.normal(75.0, 8.0, 500)
            else:
                # Ehrlicher Sensor schickt reale Kontextdaten + leichtes Rauschen
                data = np.random.normal(true_mean + np.random.uniform(-1, 1), true_std, 500)
            
            # Histogramm als Wahrscheinlichkeitsverteilung P berechnen
            hist, _ = np.histogram(data, bins=bins, density=True)
            hist = np.where(hist == 0, 1e-6, hist)  # Vermeidung von Div-by-Zero
            hist /= np.sum(hist)
            sensor_data.append(hist)
            
        # 2. Aggregierten Kontext-Erwartungswert (P_Kontext) gewichtet berechnen
        P_kontext = np.average(sensor_data, axis=0, weights=weights)
        P_kontext /= np.sum(P_kontext)
        
        # 3. Kullback-Leibler-Divergenz & Gewichts-Decay anwenden
        for i in range(num_sensors):
            P_sensor = sensor_data[i]
            # D_KL(P_Sensor || P_Kontext)
            d_kl = entropy(P_sensor, P_kontext)
            
            # Formel aus Artikel II: Gewichts-Update
            weights[i] = weights[i] * np.exp(-alpha * d_kl)
            
            # Auslösen des stochastischen Verifikationsmodus
            if weights[i] < w_threshold and i == spoofed_sensor_id and t == attack_step + 3:
                print(f"[ALERT] Schritt {t}: Sensor {i} unterschreitet Schwellenwert (w_{i} = {weights[i]:.4f}). Stochastische Peer-Verifikation aktiviert!")
                
        weight_history.append(weights.copy())

    weight_history = np.array(weight_history)
    
    # Visualisierung der Ergebnisse
    plt.figure(figsize=(10, 5))
    for i in range(num_sensors):
        if i == spoofed_sensor_id:
            plt.plot(weight_history[:, i], label=f'Sensor {i} (Spoofed/Adversary)', color='red', linewidth=2.5)
        else:
            plt.plot(weight_history[:, i], color='gray', alpha=0.5)
            
    plt.axhline(y=w_threshold, color='black', linestyle='--', label=f'Verifikations-Schwelle ({w_threshold})')
    plt.title('KL-Divergenz Entropie-Decay für Orakel-Sensoren (Artikel II)')
    plt.xlabel('Zeitschritte (t)')
    plt.ylabel('Sensorgewichtung (w_i)')
    plt.legend()
    plt.grid(True)
    plt.show()

if __name__ == "__main__":
    simulate_oracle_network()
