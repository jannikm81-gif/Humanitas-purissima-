import numpy as np
def kl_divergence(p: np.ndarray, q: np.ndarray, epsilon: float = 1e-10) -> float:
"""Berechnet die Kullback-Leibler-Divergenz D_KL(P || Q) zwischen zwei Verteilungen."""
p = np.clip(p, epsilon, 1.0)
q = np.clip(q, epsilon, 1.0)
p = p / np.sum(p)
q = q / np.sum(q)
return float(np.sum(p * np.log(p / q)))
def update_sensor_weights(
weights: np.ndarray,
p_sensors: np.ndarray,
p_context: np.ndarray,
gamma: float = 2.0,
) -> np.ndarray:
"""Aktualisiert die Sensorgewichte basierend auf Artikel II (Entropie-Decay)."""
new_weights = np.zeros_like(weights)
for i in range(len(weights)):
d_kl = kl_divergence(p_sensors[i], p_context)
# Formel: w_i(t+1) = w_i(t) * exp(-gamma * D_KL)
new_weights[i] = weights[i] * np.exp(-gamma * d_kl)
return new_weights
def run_oracle_simulation(
n_sensors: int = 10, n_malicious: int = 3, timesteps: int = 5
):
print("=== Humanitas Purissima - Adversarielles Orakel-Modell (Artikel II) ===")
print(f"Sensoren gesamt: {n_sensors} | Maliziöse/Gefälschte Knoten: {n_malicious}\n")
# Initialgewicht aller Sensoren = 1.0
weights = np.ones(n_sensors)
# Echter Raum-Zeit-Kontext (z. B. Umweltsensor-Messwerte über 4 Kategorien)
p_context = np.array([0.25, 0.30, 0.25, 0.20])
for t in range(1, timesteps + 1):
p_sensors = []
for i in range(n_sensors):
if i < (n_sensors - n_malicious):
# Ehrlicher Sensor: nahe am echten Kontext mit geringem Rauschen
noise = np.random.normal(0, 0.02, size=4)
p_i = np.abs(p_context + noise)
else:
# Gefälschter Sensor (Kartell/Spoofing): stark abweichende Verteilung
p_i = np.array([0.80, 0.05, 0.05, 0.10])
p_sensors.append(p_i)
weights = update_sensor_weights(weights, np.array(p_sensors), p_context)
n_honest = n_sensors - n_malicious
print(f"--- Zeitschritt {t} ---")
print(f"Ehrliche Knoten (Schnitt-Gewicht):  {np.mean(weights[:n_honest]):.4f}")
print(f"Gefälschte Knoten (Schnitt-Gewicht): {np.mean(weights[n_honest:]):.4f}")
if name == "main":
np.random.seed(42)
run_oracle_simulation()
